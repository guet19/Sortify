# Vorlage für die Umgebungsvariablen (lokal in .env kopieren, auf Netlify unter Site settings > Environment variables)

# Datenbank (MongoDB Atlas)
DB_URI=mongodb+srv://BENUTZER:PASSWORT@cluster.example.mongodb.net/
BASE_URL=http://localhost:5173

# Bilder (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# E-Mail (Gmail mit App-Passwort)
SMTP_EMAIL=
SMTP_PASSWORD=

# KI (Google Gemini)
GEMINI_API_KEY=
# Optional: Zeitbudget der KI pro Anfrage in ms (Standard auf Netlify: 26000)
# AI_MAX_DURATION_MS=26000

# Täglicher Mindestbestand-Hinweis (netlify/functions/low-stock.mjs): langer Zufallswert, z.B. openssl rand -hex 32
CRON_SECRET=

# Terminals (MQTT-Broker, z.B. EMQX Serverless oder Mosquitto) – siehe terminal/README.md
MQTT_HOST=xxxxxxxx.ala.eu-central-1.emqxsl.com
MQTT_PORT=8883
# Zugang für Sortify (darf nur veröffentlichen)
MQTT_SERVER_USERNAME=
MQTT_SERVER_PASSWORD=
# Zugang, den gekoppelte Terminals erhalten (darf nur abonnieren)
MQTT_DEVICE_USERNAME=
MQTT_DEVICE_PASSWORD=
# Optional
# MQTT_TOPIC_PREFIX=sortify
# MQTT_TLS=false   # nur für einen lokalen Test-Broker ohne TLS
